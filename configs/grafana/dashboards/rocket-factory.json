{
  "uid": "rocket-factory-overview",
  "title": "Rocket Factory — Overview",
  "tags": ["rocket-factory"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(rocket_factory_http_requests_total, service)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Бизнес-показатели",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Создание заказов, /с",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (result) (rate(rocket_factory_orders_created_total[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Оплаты по исходу, /с",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (status) (rate(rocket_factory_payments_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Резервы склада и производство, /с",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (status) (rate(rocket_factory_inventory_reservations_total[5m]))",
          "legendFormat": "reservation {{status}}",
          "refId": "A"
        },
        {
          "expr": "sum by (status) (rate(rocket_factory_production_tasks_total[5m]))",
          "legendFormat": "production {{status}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "HTTP",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "Запросы по маршрутам, /с",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (route) (rate(rocket_factory_http_requests_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Латентность p95 / p99",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(rocket_factory_http_request_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "p95 {{route}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(rocket_factory_http_request_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "p99 всего",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Доля ошибок",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(rocket_factory_http_errors_total{service=~\"$service\"}[5m])) / clamp_min(sum(rate(rocket_factory_http_requests_total{service=~\"$service\"}[5m])), 0.001)",
          "legendFormat": "ошибки",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Kafka и outbox",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }
    },
    {
      "type": "timeseries",
      "title": "Обработка событий, /с",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (consumer) (rate(rocket_factory_kafka_messages_processed_total[5m]))",
          "legendFormat": "обработано {{consumer}}",
          "refId": "A"
        },
        {
          "expr": "sum by (reason) (rate(rocket_factory_kafka_messages_skipped_total[5m]))",
          "legendFormat": "пропущено {{reason}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ошибки консьюмеров и DLQ, /с",
      "description": "Любой ненулевой поток в DLQ требует разбора: события туда попадают после исчерпания повторов.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (consumer) (rate(rocket_factory_kafka_consumer_errors_total[5m]))",
          "legendFormat": "ошибки {{consumer}}",
          "refId": "A"
        },
        {
          "expr": "sum by (consumer) (rate(rocket_factory_kafka_dlq_messages_total[5m]))",
          "legendFormat": "DLQ {{consumer}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Очередь outbox",
      "description": "Рост возраста самого старого неопубликованного события означает, что доставка встала.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 17 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (service) (rocket_factory_outbox_events_pending)",
          "legendFormat": "не опубликовано {{service}}",
          "refId": "A"
        },
        {
          "expr": "max(rocket_factory_outbox_oldest_pending_age_seconds)",
          "legendFormat": "возраст самого старого, с",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "Ресурсы",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }
    },
    {
      "type": "timeseries",
      "title": "Пул соединений PostgreSQL",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 25 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "expr": "rocket_factory_pgx_acquired_conns{service=~\"$service\"}",
          "legendFormat": "занято {{service}}",
          "refId": "A"
        },
        {
          "expr": "rocket_factory_pgx_max_conns{service=~\"$service\"}",
          "legendFormat": "максимум {{service}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "gRPC по кодам ответа, /с",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (code) (rate(rocket_factory_grpc_requests_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ]
    }
  ]
}
