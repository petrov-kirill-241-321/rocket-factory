# Окружение. В local допускается значение JWT_SECRET по умолчанию.
APP_ENV=local
LOG_LEVEL=info

# --- PostgreSQL ---
POSTGRES_USER=rocket
POSTGRES_PASSWORD=rocket
POSTGRES_DB=rocket_factory
POSTGRES_HOST=postgres
# Порт внутри docker-сети, по нему подключаются сервисы.
POSTGRES_INTERNAL_PORT=5432
# Порт, проброшенный на хост. Меняйте его при конфликте — на подключение
# сервисов это не влияет.
POSTGRES_HOST_PORT=5432
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=30m

# --- Redis ---
REDIS_ADDR=redis:6379
REDIS_HOST_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_TTL=24h

# --- Kafka ---
KAFKA_BROKERS=kafka:9092
KAFKA_HOST_PORT=9094
KAFKA_ORDER_EVENTS_TOPIC=order.events
KAFKA_PAYMENT_EVENTS_TOPIC=payment.events
KAFKA_INVENTORY_EVENTS_TOPIC=inventory.events
KAFKA_PRODUCTION_EVENTS_TOPIC=production.events
KAFKA_DLQ_TOPIC=rocket.dlq
# Число попыток обработки одного события перед отправкой в DLQ.
KAFKA_CONSUMER_MAX_ATTEMPTS=5
KAFKA_CONSUMER_RETRY_BACKOFF=200ms

# --- Аутентификация ---
# Значение по умолчанию допустимо только при APP_ENV=local.
JWT_SECRET=change-me-local-secret
JWT_TTL=24h

# --- Производство ---
PRODUCTION_DURATION=5s
PRODUCTION_RECONCILE_INTERVAL=5s

# --- Наблюдаемость ---
# Экспорт трейсов выключен по умолчанию: без профиля observability
# коллектора нет, и сервисы иначе засоряли бы логи ошибками подключения.
# Включается автоматически при docker compose --profile observability.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# --- Порты на хосте ---
NGINX_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
JAEGER_UI_PORT=16686

# --- Адреса сервисов внутри сети ---
AUTH_SERVICE_GRPC_ADDR=auth-service:9090
ORDER_SERVICE_GRPC_ADDR=order-service:9090
INVENTORY_SERVICE_GRPC_ADDR=inventory-service:9090
PAYMENT_SERVICE_GRPC_ADDR=payment-service:9090
PRODUCTION_SERVICE_GRPC_ADDR=production-service:9090
